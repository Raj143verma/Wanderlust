<% layout("/layouts/boilerplate") %>
<div class="container mt-5">
  <div class="row">
    <div class="col-12 col-md-10 offset-md-1 col-lg-10 offset-lg-1">
      <h3 class="mb-4">Confirm your booking</h3>
      <div class="row">
        <!-- LEFT SIDE -->
        <div class="col-md-7 col-lg-8 mb-4 pe-lg-4">
          <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <img src="<%= listing.image.url %>" class="card-img-top rounded-3" alt="Listing Image" style="height: 300px; object-fit: cover;">
            <div class="card-body px-1">
              <h5 class="card-title fw-bold fs-4"><%= listing.title %></h5>
              <p class="card-text text-muted mb-1"><i class="bi bi-geo-alt-fill"></i> <%= listing.location %>, <%= listing.country %></p>
              <p class="card-text mt-3"><strong>Hosted by:</strong> <%= listing.owner ? listing.owner.username : "Unknown" %></p>
            </div>
          </div>
        </div>
        
        <!-- RIGHT SIDE -->
        <style>
          @media (min-width: 992px) {
            .checkout-card-expand {
              width: calc(100% + 80px) !important;
              max-width: 500px !important;
            }
          }
        </style>
        <div class="col-md-5 col-lg-4 mb-4">
          <div class="card shadow border rounded-4 checkout-card checkout-card-expand h-100">
            <div class="card-body p-4 d-flex flex-column">
              <h4 class="card-title fw-bold border-bottom pb-3 mb-4">Booking Summary</h4>
              
              <div class="d-flex justify-content-between mb-3">
                <span class="text-muted">Check-In</span>
                <span class="fw-semibold"><%= checkIn %></span>
              </div>
              <div class="d-flex justify-content-between mb-3">
                <span class="text-muted">Check-Out</span>
                <span class="fw-semibold"><%= checkOut %></span>
              </div>
              <div class="d-flex justify-content-between border-bottom pb-3 mb-4">
                <span class="text-muted">Guests</span>
                <span class="fw-semibold"><%= guests %> <% if(guests == '1') { %>guest<% } else { %>guests<% } %></span>
              </div>

              <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">₹<%= listing.price.toLocaleString("en-IN") %> x <%= nights %> nights</span>
                <span>₹<%= totalPrice.toLocaleString("en-IN") %></span>
              </div>
              
              <div class="d-flex justify-content-between fw-bold fs-5 mt-auto pt-3 border-top">
                <span>Total</span>
                <span>₹<%= totalPrice.toLocaleString("en-IN") %></span>
              </div>

              <button class="btn btn-danger w-100 py-3 mt-4 rounded-3 text-white fw-bold fs-5" style="border-radius: 8px !important;">Pay Now</button>
            </div>
          </div>
        </div>
        
      </div>

      <!-- HOST INFORMATION SECTION -->
      <div class="card shadow-sm border rounded-4 mt-5 mb-5">
        <div class="card-body p-4">
          <!-- TOP SECTION -->
          <div class="d-flex align-items-center mb-1">
            <div class="bg-dark text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 60px; height: 60px; font-size: 1.7rem;">
              <i class="fa-solid fa-user"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1">Hosted by <%= listing.owner ? listing.owner.username : "Unknown" %></h5>
              <p class="text-muted mb-0">Superhost <span class="mx-2">|</span> Hosting since 2025</p>
            </div>
          </div>
          
          <hr class="my-4">
          
          <!-- BOTTOM SECTION -->
          <div class="d-flex align-items-start">
            <div class="me-3 text-muted mt-1" style="font-size: 1.5rem;">
              <i class="bi bi-chat-left-text"></i>
            </div>
            <div>
              <h5 class="fw-semibold mb-2">Message from host</h5>
              <p class="mb-0">Please let me know purpose of your visit, number of guests, and expected arrival time.</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>