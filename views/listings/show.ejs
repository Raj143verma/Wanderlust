<% layout('layouts/boilerplate') %>
<script type="application/json" id="listing-data"><%- JSON.stringify(listing) %></script>
<script>
  const mapToken = '<%= process.env.MAPBOX_TOKEN %>';
  const listingData = document.getElementById('listing-data');
  const listing = listingData ? JSON.parse(listingData.textContent) : null;
  const coordinates = listing && listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates : null;
 
</script>
<div class="row mt-3">
  <div class="col-12 col-md-10 offset-md-1 col-lg-10 offset-lg-1">
    <h3 class="mb-3"><%= listing.title %></h3>
    <div class="row">
      <!-- LEFT SECTION -->
      <div class="col-12 col-md-7 col-lg-8 pe-lg-4">
        <div class="card show-card listing-card border-0"> 
          <img src="<%= listing.image.url%>" class="card-img-top show-img rounded-4" alt="listing_image" style="height: 350px; object-fit: cover;">
          <div class="card-body px-0 mt-4">
            <div class="d-flex align-items-center mb-3">
              <div class="user-avatar bg-dark text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 45px; height: 45px; font-size: 1.25rem;">
                <i class="fa-solid fa-user"></i>
              </div>
              <div>
                <h5 class="mb-0 fw-bold">Hosted by <%= listing.owner ? listing.owner.username : 'Unknown' %></h5>
                <p class="text-muted mb-0" style="font-size: 0.9rem;">Superhost</p>
              </div>
            </div>
            <hr />
            <p class="card-text mt-3"><%= listing.description %> </p>
            <p class="card-text"> &#8377; <%= listing.price.toLocaleString("en-IN") %> </p>
             <p class="card-text"><%= listing.location %> </p>
            <p class="card-text"><%= listing.country %> </p>
           </div>
        </div>

        <% if(currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
        <div class="btns mb-4 d-flex align-items-center">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn me-3 px-4">Edit</a>
          <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="m-0">
            <button class="btn btn-dark px-4">Delete </button>
          </form>
        </div>
        <% } %>

        <hr />
         
        <div class="mb-3 mt-4">
           <% if(listing.reviews.length === 0) { %>
            <p class="text-center">No reviews yet! Be the first one to review this listing.</p>
          <h4>Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
            <label for="first-rate1" class="form-label">Rating:</label>
        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
        </div>

            <div class="mb-3 mt-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
              <div class="invalid-feedback">Please submit some comments for review.</div>
            </div>
            <button class="btn btn-outline-dark">Submit </button>
           </form>
           <% } %>
           
            <% if(listing.reviews.length > 0) { %>
            <div class="row">
            <h4><b> All Reviews</b></h4>
            <% for(review of listing.reviews) { %> 
              <div class="card col-12 col-sm-5 ms-3 mb-3 border">
               <div class="card-body p-2 px-3">
                  <h5 class="card-title mt-2">@<%= review.author.username %></h5>
                   <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                 <p class="card-text mb-2"><%= review.comment %></p>
             <form class="mb-2" method="POST" action="/listings/<%=listing._id%>/reviews/<%= review._id %>?_method=DELETE"  >
              <button class="btn btn-sm btn-outline-dark">Delete </button>
              </form>
              </div>
              </div>
              <% } %>
              </div>
              <% } %>
        </div>

        <hr/>
        <div class="mb-3 mt-4 w-100">
          <h4>Where you'll be staying</h4>
          <div id="map" class="mt-3 rounded-4 w-100"></div>
        </div>
      </div>

      <!-- RIGHT SECTION Booking Card -->
      <style>
        @media (min-width: 992px) {
          .booking-card-expand {
            width: calc(100% + 80px) !important;
            max-width: 500px !important;
          }
        }
      </style>
      <div class="col-12 col-md-5 col-lg-4 mt-4 mt-md-0 position-relative">
        <div class="card shadow-sm border rounded-4 booking-card booking-card-expand" style="top: 100px; position: sticky; width: 100%; min-height: 350px; display: flex; flex-direction: column;">
          <div class="card-body p-4 d-flex flex-column">
            <h4 class="card-title fw-bold m-0 fs-3">₹<%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 fw-normal text-muted">night</span></h4>
            
            <div class="border rounded-3 mt-4 mb-auto overflow-hidden flex-grow-1 d-flex flex-column justify-content-center">
              <div class="d-flex border-bottom">
                <div class="p-3 border-end w-50">
                  <span class="d-block text-muted" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 1px;">CHECK-IN</span>
                  <input type="date" name="checkIn" form="bookForm" class="form-control border-0 p-0 mt-2 shadow-none bg-transparent" style="font-size: 0.95rem; cursor: pointer;" required>
                </div>
                <div class="p-3 w-50">
                  <span class="d-block text-muted" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 1px;">CHECKOUT</span>
                  <input type="date" name="checkOut" form="bookForm" class="form-control border-0 p-0 mt-2 shadow-none bg-transparent" style="font-size: 0.95rem; cursor: pointer;" required>
                </div>
              </div>
              <div class="p-3">
                <span class="d-block text-muted" style="font-size: 0.65rem; font-weight: 700; letter-spacing: 1px;">GUESTS</span>
                <select name="guests" form="bookForm" class="form-select border-0 p-0 mt-2 shadow-none bg-transparent" style="font-size: 0.95rem; cursor: pointer;">
                  <option value="1">1 guest</option>
                  <option value="2">2 guests</option>
                  <option value="3">3 guests</option>
                  <option value="4">4 guests</option>
                  <option value="5">5+ guests</option>
                </select>
              </div>
            </div>

            <% if(currentUser) { %>
              <% if(hasBooked) { %>
                <form action="/listings/<%= listing._id %>/book?_method=DELETE" method="POST" class="m-0 p-0 w-100">
                  <button type="submit" class="btn add-btn w-100 py-3 mt-4 rounded-3 text-white fw-bold fs-5" style="border-radius: 8px !important;">Cancel Booking</button>
                </form>
              <% } else { %>
                <form id="bookForm" action="/listings/<%= listing._id %>/checkout" method="GET" class="m-0 p-0 w-100">
                  <button type="submit" class="btn add-btn w-100 py-3 mt-4 rounded-3 text-white fw-bold fs-5" style="border-radius: 8px !important;">Book Now</button>
                </form>
              <% } %>
            <% } else { %>
              <a href="/login" class="btn add-btn w-100 py-3 mt-4 rounded-3 text-white fw-bold d-block text-center text-decoration-none fs-5" style="border-radius: 8px !important;">Login to Book</a>
            <% } %>

          </div>
        </div>
      </div>
      <!-- End of right column -->
      
    </div>
  </div>
</div>
<script src="/js/map.js"></script>

